APP_NAME="Yandex Reviews"
APP_ENV=local
# Пустой ключ в докере сгенерируется сам и сохранится в томе storage.
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8095
# Порт, на котором docker compose публикует приложение.
APP_PORT=8095

APP_LOCALE=ru
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ru_RU

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=info

# В docker compose хост и доступы подставляются из docker-compose.yml.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=yandex_reviews
DB_USERNAME=yandex_reviews
# Стендовый пароль для локального запуска, на сервере задаётся свой.
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=720
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Домены, с которых фронт ходит в API с сессионной кукой (хост:порт через запятую).
# Если не задано, Sanctum берёт localhost, 127.0.0.1 и хост:порт из APP_URL. Если задать, список
# заменяет дефолт целиком: адрес, по которому открывают стенд, обязан в нём быть, иначе вход не работает.
# SANCTUM_STATEFUL_DOMAINS=reviews.example.com

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log

# Пользователь, которого создаёт сид (регистрации нет). Пароль стендовый, на сервере задать свой.
SEED_USER_NAME="Демо"
SEED_USER_EMAIL=demo@example.com
SEED_USER_PASSWORD=demo12345

# ---- Парсер Яндекс.Карт ----
YANDEX_BASE_URL=https://yandex.ru
YANDEX_TIMEOUT=20
YANDEX_MAX_PAGES=12
# Пауза между любыми запросами к Яндексу со всех воркеров + случайная добавка.
YANDEX_MIN_INTERVAL_MS=1500
YANDEX_JITTER_MS=1000
# Сколько секунд не ходить к Яндексу после капчи/429.
YANDEX_BLOCK_COOLDOWN=900
# Сколько раз перезапросить страницу, если Яндекс разово ответил ошибкой, и с какой паузой.
YANDEX_PAGE_RETRIES=2
YANDEX_PAGE_RETRY_DELAY_MS=3000
# Прокси через запятую: http://user:pass@host:port. Если пусто, ходим напрямую.
YANDEX_PROXIES=
YANDEX_CANARY_URL=https://yandex.ru/maps/org/yandeks/1124715036/
